#include "trackfinderalgorithms.fcl"
#include "ProtoDUNEBeamlineUtils.fcl"
#include "ProtoDUNECalibration.fcl"

BEGIN_PROLOG

highlandAnalysis:
{
  module_type:		"CreateHighlandMiniTree"

  BeamModuleLabel:	"beamevent"
  BeamlineUtils:        @local::standard_protodunebeamlineutils
  
  PFParticleTag:        "pandora"
  GeneratorTag:         "generator"
  CosmicGeneratorTag:   "cosmicgenerator"
  TrackerTag:           "pandoraTrack"
  ShowerTag:            "pandoraShower"
  CalorimetryTag:       "pandoracali"
  CalorimetryTagNoSCE:  "pandoracalonosce"	
  HitTag:               "hitpdune"
  
  PIDFilename:		"dEdxrestemplates.root"

  MaxGeneration:	10
  MCMaxGeneration:	100	

  NominalBeamMom:	1.0

  # ---- what to save (phase2.md) ----
  SaveHitsAllPlanes:      true   # calorimetry hits of the three planes (Hits) and the rest of hits of the PFParticle (HitsNoCalo); false: only collection plane of tracks
  SaveSpacePoints:        true   # 3D space points of the PFParticles without track
  SaveTrackSpacePoints:   false  # also for tracks (raw positions of their trajectory points, one per hit with 3D)
  CosmicsMode:            2      # 0 none, 1 summary (no hits/trajectory/space points), 2 complete near the beam slice, 3 complete
  CosmicsRadius:          50.    # cm, distance to the ends of the beam slice for CosmicsMode 2
  CosmicsTruthMode:       1      # 0 none, 1 only cosmics matched to saved reco objects, 2 all
  SaveUnassociatedHits:   true   # hits without PFParticle near the ends of the beam slice
  UnassociatedHitsRadius: 30.    # cm, 2D distance (wire, drift) in each plane
  TrueTrajPDGs:           [321, -321] # true trajectory (the beam particle is always saved)
  SaveHitSignal:          false  # waveform of each hit
  FullDumpPrescale:       0      # complete dump in 1 of every N events (0 = never)

  Debug:                false
}

END_PROLOG