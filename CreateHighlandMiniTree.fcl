#include "trackfinderalgorithms.fcl"
#include "ProtoDUNEBeamlineUtils.fcl"
#include "ProtoDUNECalibration.fcl"
#include "ProtoDUNEDataUtils.fcl"
#include "ProtoDUNEUnstableHVFilter.fcl"
#include "ProtoDUNEEmptyEventFinder.fcl"

BEGIN_PROLOG

highlandAnalysis:
{
  module_type:		"CreateHighlandMiniTree"

  BeamModuleLabel:	"beamevent"
  BeamlineUtils:        @local::standard_protodunebeamlineutils
  
  PFParticleTag:        "pandora"
  GeneratorTag:         "generator"
  CosmicGeneratorTag:   "cosmicgenerator"
  TrackerTag:           "pandoraTrack"
  ShowerTag:            "pandoraShower"
  CalorimetryTag:       "pandoracali"
  CalorimetryTagNoSCE:  "pandoracalonosce"	
  HitTag:               "hitpdune"
  
  PIDFilename:		"dEdxrestemplates.root"

  MaxGeneration:	10
  MCMaxGeneration:	100	

  NominalBeamMom:	1.0

  # EventInfo.EmptyEvent (no beam activity at the TPC entrance) and NBeamRegionSpacePoints, as
  # PDSPAnalyzer: space points of reco3d in a box (different for data and MC). Without reco3d,
  # NBeamRegionSpacePoints = -1 and EmptyEvent = false
  EmptyEventFinder:     @local::standard_protoduneemptyeventfinder

  # ---- what to save (phase2.md) ----
  SaveHitsAllPlanes:      true   # calorimetry hits of the three planes (Hits) and the rest of hits of the PFParticle (HitsNoCalo); false: only collection plane of tracks
  SaveSpacePoints:        true   # 3D space points of the PFParticles without track
  SaveTrackSpacePoints:   false  # also for tracks (raw positions of their trajectory points, one per hit with 3D)
  # cosmics, each level includes the previous one (criteria on the space points of the whole cosmic hierarchy):
  # 0 none, 1 summary for all (no hits/trajectory/space points), 2 complete if near the ends of the
  # beam-slice particles, 3 complete also if it crosses the beam volume, 4 complete for all
  CosmicsMode:            2
  CosmicsRadius:          50.    # cm, distance to the ends of all the beam-slice particles (CosmicsMode >= 2)
  CosmicsWithoutBeamSlice: false # also in events without beam slice (they are not analysed; only EventInfo, Beam, DQ and truth are needed)
  # mu candidates (mu+ of K+ decaying at rest), from CosmicsMode 2: complete the hierarchies with a track
  # of mu range momentum 150-350 MeV/c that stops and has an end near the beam axis (it does not need
  # the beam slice). Chosen with the 6 GeV MC (2026-11-19): of the mu of K+ outside the beam slice that
  # CosmicsMode 2 leaves in summary, recovers 101 of 288 for +5.5 complete PFParticles per event (with
  # 180-300 MeV/c). Widened on 2026-11-20 to 150-350 MeV/c (sidebands on both sides of the peak at
  # ~230 MeV/c also outside the beam slice; x1.35 candidates). With the ancestors of the truth
  # (SaveTrueAncestors), +4 % of file size (10 MC events, 2026-11-20)
  MuCandidates:           true
  MuCandidatesWithoutBeamSlice: true # in events without beam slice, save those hierarchies (only them, complete)
  MuCandidateLength:      [21.20, 104.53] # cm, mu range (pdAnaUtils::ComputeRangeMomentum) of 150 and 350 MeV/c
  # also the PFParticles without track, with their forced track (ForcedTrackTag). Pandora calls shower
  # about a third of these mu, but most showers of cosmics have a forced track of this length and their
  # whole hierarchies are saved: +61 % of file size (instead of +4 %) in 10 MC events (2026-11-20).
  # On since 2026-11-23: outside the beam slice half of the mu from K at rest are showers (only saved
  # complete in data with this flag); their length can be measured from the space points (highlandPD
  # mu_cand_v100d study). Storage fits (MC ~1.1 TB)
  MuCandidateShowers:     true
  MuCandidateAxisRadius:  150.   # cm, distance of an end to the beam axis (BeamVolumeStart/Direction/Length)
  MuCandidateStopMargin:  10.    # cm, an end at least this far from the faces of the active volume
  ActiveVolume:           [-360., 360., 0., 607.5, 0., 695.] # cm, TPC active volume (no SCE)
  # beam axis, different for data and MC. Start: mean of the 6 GeV beam quality cuts of highlandPD
  # (pdUtils.parameters.dat). Valid for 3-7 GeV: the means of the 3 and 7 GeV cuts differ by 1-2 cm,
  # nothing next to BeamVolumeRadius and MuCandidateAxisRadius. Direction: nominal value, to be
  # measured in data and MC (highlandPD test/phase2/beam_axis_minitrees.C)
  BeamVolumeStartData:     [-28.6, 424.6, 0.96]  # cm
  BeamVolumeStartMC:       [-30.1, 423.0, 0.0]   # cm
  BeamVolumeDirectionData: [-0.18, -0.20, 0.96]
  BeamVolumeDirectionMC:   [-0.18, -0.20, 0.96]
  BeamVolumeRadius:       50.    # cm (CosmicsMode >= 3)
  BeamVolumeLength:       700.   # cm, along the axis
  CosmicsTruthMode:       1      # 0 none, 1 only cosmics matched to saved reco objects, 2 all
  SaveUnassociatedHits:   true   # hits without PFParticle near the ends of the beam slice
  UnassociatedHitsRadius: 30.    # cm, 2D distance (wire, drift) in each plane
  TrueTrajPDGs:           [321, -321] # true trajectory (the beam particle is always saved)
  SaveHitSignal:          false  # waveform of each hit
  SaveForcedTracks:       true   # track fit forced on the PFParticles without track (shower-like)
  ForcedTrackTag:         "pandora2Track"
  SaveForcedTrackHits:    false  # also its hits (with calorimetry) and trajectory points; otherwise ends, length and chi2 only
  ForcedCalorimetryTag:   "pandora2cali"
  SaveTrueHitCounts:      true   # MC: NHitsTrue and EDepTrue of the true particles (all the hits are always backtracked once: TrueID of the hits, purity, completeness)
  # MC: the ancestors of the true particles matched to a PFParticle but not reached by the recursion from
  # the beam particle (MCMaxGeneration), up to a stored one. Without them ~40 % of the mu+ of K+ at rest
  # could not be traced back to the beam (6 GeV MC, 2026-11-20): needed to know if the K+ comes from the
  # interaction of the beam particle
  SaveTrueAncestors:      true

  # data quality: what the FEMB and unstable HV filters check, saved instead of filtering (data only)
  DataUtils:              @local::standard_protodunedatautils
  UnstableHVTimeRanges:   @local::HVfilter.TimeRanges
  FullDumpPrescale:       0      # complete dump in 1 of every N events (0 = never)
  FullDumpTruePDGs:       []     # MC: complete dump of the events with any of these true PDGs in the beam chain (not the
                                 # beam particle itself), also without beam slice. For efficiency studies: biased by the truth
                                 # (AnaParticlePD::CosmicCriteria tells what a normal event would have saved complete)
  CompressionSettings:    208    # output file: 100*algorithm + level (208 LZMA 8: the smallest; 505 ZSTD 5; 101 zlib 1)

  Verbose:              true   # flow of each event: one line per step, with what was found and its time
  Debug:                false  # details of each particle (true matching, ...)
}

END_PROLOG