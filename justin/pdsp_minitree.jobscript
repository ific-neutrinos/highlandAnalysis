#!/bin/bash
# justIN jobscript: ProtoDUNE-SP (dunesw v09_56_00d00) + CreateHighlandMiniTree -> minitree.
#
# Se lanza con --monte-carlo N (datos y MC igual, aunque parte del MC esté en MetaCat): cada
# trabajo recibe un contador k y procesa FILES_PER_JOB líneas consecutivas de una lista de URLs
# xrootd que va en el tarball (hecha con make_filelist.sh desde SAM, con prestage): las líneas
# (k-1)*F+1 ... k*F, sin contar comentarios ni líneas vacías. N = ceil(ficheros/F).
#
# Variables (--env):
#   MODE           mc | data                          (obligatoria)
#   LIST           lista dentro de pdsp_runtime/lists (por defecto filelist_${MODE}.txt)
#   FILES_PER_JOB  ficheros por trabajo               (por defecto 1)
#   NEVENTS        eventos por fichero                (por defecto -1, todos)
#   DEBUG_GDB      1: corre lar bajo gdb (primer fichero del trabajo) y sale
#   INPUT_TAR_DIR_LOCAL: directorio del tarball en cvmfs (justin-cvmfs-upload)
#
# Salidas: por cada fichero de entrada, minitree_<entrada>.root (si lar acaba bien) y
# stats_<entrada>.txt (siempre, también si lar falla: una línea clave=valor para summarize.sh).
#
# Estado de salida: 0 si al menos un fichero sale bien. Los que fallan se quedan sin minitree y
# con status != 0 en sus stats (summarize.sh los lista y RETRY_LIST=... los escribe en una lista
# para relanzarlos con LIST=...); justIN no los reintenta. Si fallan todos, 1: justIN reintenta
# el contador (problema del nodo, del setup o de la lectura).
#
# Sin "set -e"/"set -u" antes de los setup: UPS, setup_dune.sh y los setup de HighLAND no
# los toleran. Sin "set -x": imprimía cada línea de los setup de UPS. Cada paso escribe una
# línea "==> ..."; el log completo de lar queda en lar_<i>.log (en pantalla solo el final).
step() { echo "==> [$(date +%H:%M:%S)] $*"; }
tree_pids() { local p; for p in $(pgrep -P "$1"); do echo "$p"; tree_pids "$p"; done; }   # descendientes

NEVENTS=${NEVENTS:--1}
FILES_PER_JOB=${FILES_PER_JOB:-1}
case "${MODE:-}" in
    mc|data) ;;
    *) echo "ERROR: MODE tiene que ser mc o data (--env MODE=...)"; exit 1 ;;
esac
[[ "$FILES_PER_JOB" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: FILES_PER_JOB=$FILES_PER_JOB no es un entero positivo"; exit 1; }

RT="$INPUT_TAR_DIR_LOCAL/pdsp_runtime"
LIST="$RT/lists/${LIST:-filelist_${MODE}.txt}"

# 1. Contador de justIN -> líneas de la lista
did_pfn_rse=$("$JUSTIN_PATH/justin-get-file")
if [[ -z "$did_pfn_rse" ]]; then
    echo "No files available"
    exit 0
fi
read -r did pfn rse <<< "$did_pfn_rse"
echo "justIN DID: $did  PFN: $pfn"

# El contador es el último número del DID. Comprobar el formato con justin-test-jobscript.
[[ -f "$LIST" ]] || { echo "ERROR: no existe la lista $LIST"; exit 1; }
counter=$(echo "$did" | grep -o '[0-9]\+' | tail -1)
counter=$((10#${counter:-0}))
first=$(( (counter-1)*FILES_PER_JOB + 1 ))
last=$((  counter*FILES_PER_JOB ))
mapfile -t inputs < <(grep -v -e '^#' -e '^[[:space:]]*$' "$LIST" | sed -n "${first},${last}p")
if [[ ${#inputs[@]} -eq 0 ]]; then
    echo "Contador $counter (líneas $first-$last) fuera de la lista ($(grep -c -v -e '^#' -e '^[[:space:]]*$' "$LIST") ficheros): nada que hacer"
    echo "$pfn" > justin-processed-pfns.txt
    exit 0
fi
step "Contador $counter: líneas $first-$last de $(basename "$LIST") (${#inputs[@]} ficheros)"
for u in "${inputs[@]}"; do echo "    $u"; done

# 2. Entorno DUNE (SL7: dunesw v09 necesita la imagen de SL7)
unset prod_db
set +eu
step "Sistema operativo: $(cat /etc/redhat-release 2>/dev/null || grep PRETTY_NAME /etc/os-release)"
step "setup dunesw v09_56_00d00"
source /cvmfs/dune.opensciencegrid.org/products/dune/setup_dune.sh > /dev/null
setup dunesw v09_56_00d00 -q e20:prof || { echo "ERROR: setup dunesw v09_56_00d00 falló (¿imagen sin SL7? submit.sh con IMAGE=...)"; exit 1; }

# 3. HighLAND (el setup.sh de highland no carga sus productos porque ROOTSYS ya está definido)
HL_SETUP="$RT/highland/highland/scripts/setup.sh"
HLPD_SETUP="$RT/highland/highlandPD/scripts/setup.sh"
[[ -f "$HL_SETUP" && -f "$HLPD_SETUP" ]] || { echo "ERROR: faltan los setup de HighLAND en $RT"; exit 1; }
step "setup highland y highlandPD"
source "$HL_SETUP"   > /dev/null
source "$HLPD_SETUP" > /dev/null

# Librerías del área local (el módulo y lo que necesite de protoduneana local), por delante
# de las de cvmfs. art busca los módulos en CET_PLUGIN_PATH.
export LD_LIBRARY_PATH="$RT/lib:$LD_LIBRARY_PATH"
export CET_PLUGIN_PATH="$RT/lib:$CET_PLUGIN_PATH"
export FHICL_FILE_PATH=".:$RT/fcl:$FHICL_FILE_PATH"
# Cabeceras de highland para ROOT (autoparsing de los diccionarios). El setup.sh de highland
# solo define ROOT_INCLUDE_PATH si no hay un ROOT cargado, y aquí ya lo ha cargado dunesw; sin
# esto ROOT buscaría las cabeceras en la ruta de compilación (/exp/dune/app/...), que en la grid
# no existe.
export ROOT_INCLUDE_PATH="$RT/highland/highland/include:$RT/highland/highlandPD/include:$ROOT_INCLUDE_PATH"
set -e

command -v lar > /dev/null || { echo "ERROR: lar not found"; exit 1; }
step "lar: $(command -v lar); HIGHLANDPATH=$HIGHLANDPATH; HIGHLANDPDPATH=$HIGHLANDPDPATH"

# 4. Ficheros locales (la entrada se lee por xrootd, no se copia)
FCL="CreateHighlandMiniTree_${MODE}.fcl"
OUT_DEFAULT="minitree_${MODE}.root"   # fileName del TFileService en el fcl
cp "$RT/fcl/"CreateHighlandMiniTree*.fcl . || { echo "ERROR: fcl copy failed"; exit 1; }
cp "$RT/data/dEdxrestemplates.root" .     || { echo "ERROR: data copy failed"; exit 1; }

TIME_CMD=()
[[ -x /usr/bin/time ]] && TIME_CMD=(/usr/bin/time -v -o time.txt)

# 5. lar, un fichero tras otro
set +e
nok=0
nfail=0
for i in "${!inputs[@]}"; do
    input_url=${inputs[$i]}
    line=$((first + i))
    log="lar_${i}.log"
    rm -f "$OUT_DEFAULT" time.txt
    LAR_CMD=(lar -c "$FCL" -s "$input_url" -n "$NEVENTS")
    if [[ -n "${DEBUG_GDB:-}" ]]; then
        gdb -batch -ex "catch throw logic_error" -ex run -ex "bt 15" --args "${LAR_CMD[@]}" 2>&1 | tail -80
        exit 1
    fi

    step "[$((i+1))/${#inputs[@]}] línea $line: lar -c $FCL -n $NEVENTS -s $input_url"
    start=$(date +%s)
    "${TIME_CMD[@]}" "${LAR_CMD[@]}" > "$log" 2>&1 &
    runpid=$!
    # Memoria residente máxima de lar (VmHWM de /proc, que solo crece; el máximo de todos los
    # procesos que cuelgan de runpid, cada 5 s): GNU time 1.7 da valores imposibles en algunos
    # sitios (hasta 25 GB con lar en ~2 GB; workflows 23322 y 23323)
    hwm_kb=0
    while kill -0 "$runpid" 2> /dev/null; do
        for p in "$runpid" $(tree_pids "$runpid"); do
            v=$(awk '/^VmHWM:/{print $2}' "/proc/$p/status" 2> /dev/null)
            [[ -n "$v" && "$v" -gt "$hwm_kb" ]] && hwm_kb=$v
        done
        sleep 5
    done
    wait "$runpid"
    lar_status=$?
    end=$(date +%s)
    step "lar ha terminado con estado $lar_status en $((end-start)) s"
    if [[ $lar_status -ne 0 ]]; then
        tail -200 "$log"
    else
        grep -E '^(TrigReport Events total|TimeReport CPU|MemReport  VmPeak)' "$log"
    fi

    input_name=$(basename "$input_url" .root | sed 's/[^A-Za-z0-9_.-]/_/g')
    output_file="minitree_${input_name}.root"
    stats_file="stats_${input_name}.txt"

    # Estadísticas (también si lar falla, para contarlo en el resumen)
    nev=$(grep -m1 'TrigReport Events total' "$log" | sed -n 's/.*total = *\([0-9]*\).*/\1/p')
    maxrss_kb=$( [[ -f time.txt ]] && sed -n 's/.*Maximum resident set size (kbytes): *//p' time.txt )
    cpu_user=$(  [[ -f time.txt ]] && sed -n 's/.*User time (seconds): *//p' time.txt )
    cpu_sys=$(   [[ -f time.txt ]] && sed -n 's/.*System time (seconds): *//p' time.txt )
    out_bytes=$( [[ -s "$OUT_DEFAULT" ]] && stat -c %s "$OUT_DEFAULT" || echo 0 )
    [[ $lar_status -eq 0 && $out_bytes -eq 0 ]] && lar_status=-1   # lar bien pero sin salida
    echo "mode=$MODE counter=$counter line=$line status=$lar_status events=${nev:-0} wall_s=$((end-start)) cpu_user_s=${cpu_user:-NA} cpu_sys_s=${cpu_sys:-NA} maxrss_kb=${maxrss_kb:-NA} vmhwm_kb=$hwm_kb out_bytes=$out_bytes host=$(hostname) rse=$rse input=$input_url" > "$stats_file"
    step "Stats: $(cat "$stats_file")"

    if [[ $lar_status -eq 0 ]]; then
        mv "$OUT_DEFAULT" "$output_file"
        nok=$((nok+1))
        echo "Successfully produced $output_file"
    else
        # sin minitree: un fichero a medias no se sube
        rm -f "$OUT_DEFAULT"
        nfail=$((nfail+1))
        echo "ERROR: lar failed ($lar_status) para $input_url"
    fi
done

# 6. Resultado del trabajo
step "Ficheros bien: $nok, con fallo: $nfail"
if [[ $nok -eq 0 ]]; then
    echo "ERROR: no ha salido bien ningún fichero"
    exit 1
fi
echo "$pfn" > justin-processed-pfns.txt
exit 0
